# Copy to .env and fill in. Never commit .env.

# LLM: DeepInfra (OpenAI-compatible)
DEEPINFRA_API_KEY=
# Text turns use the first model. Turns with images use the vision model.
DEEPINFRA_TEXT_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
DEEPINFRA_VISION_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
DEEPINFRA_MEMORY_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
DEEPINFRA_EMBED_MODEL=BAAI/bge-m3

# Documents: PDFs with a text layer are read locally. "ocrspace" adds OCR for scans (free plan:
# 1 MB per file, 3 pages per PDF, 500 requests per day). "none" disables OCR.
OCR_PROVIDER=ocrspace
OCR_API_KEY=

# Jev decision model through OpenRouter (decides whether a detected change is worth an alert)
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.14

# Linq sandbox shared line
LINQ_API_KEY=
LINQ_FROM_PHONE=

# The service only answers these numbers (comma-separated, E.164)
ALLOWED_NUMBERS=

# Local webhook receiver
BIND_HOST=127.0.0.1
BIND_PORT=8787
WEBHOOK_SECRET=
# Cloudflare Worker that feeds the dashboard (leave empty to run without the dashboard).
# INGEST_TOKEN must match the Worker secret of the same name.
CLOUD_URL=
INGEST_TOKEN=
# Only used to build the link that `demo link` texts back. Same value as the Worker secret DASH_TOKEN.
DASH_TOKEN=
DASHBOARD_URL=
