# Copy to .env and fill in. Never commit .env.

# Mistral (free mode may train on inputs; keep to test content)
MISTRAL_API_KEY=
MISTRAL_CHAT_MODEL=mistral-large-2512

# Linq sandbox shared line
LINQ_API_KEY=
LINQ_FROM_PHONE=

# The service only answers these numbers (comma-separated, E.164)
ALLOWED_NUMBERS=

# Local webhook receiver
BIND_HOST=127.0.0.1
BIND_PORT=8787
WEBHOOK_SECRET=
