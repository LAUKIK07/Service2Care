{
  "name": "signal2care-api",
  "private": true,
  "version": "1.0.0",
  "description": "Cloudflare Worker + D1 that feeds the Signal2Care dashboard",
  "scripts": {
    "dev": "wrangler dev --port 8788",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute signal2care --local --file=schema.sql",
    "db:remote": "wrangler d1 execute signal2care --remote --file=schema.sql"
  },
  "devDependencies": {
    "wrangler": "4.152.0"
  }
}
