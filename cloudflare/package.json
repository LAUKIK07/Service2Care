{
  "name": "signal2care-api",
  "private": true,
  "version": "2.0.0",
  "description": "Cloudflare Worker + D1 that feeds the Signal2Care dashboard",
  "scripts": {
    "dev": "wrangler dev --local --port 8788",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute signal2care --local --file=schema.sql",
    "db:remote": "wrangler d1 execute signal2care --remote --file=schema.sql",
    "migrate:local": "wrangler d1 execute signal2care --local --file=migrations/0002_story.sql",
    "migrate:remote": "wrangler d1 execute signal2care --remote --file=migrations/0002_story.sql",
    "migrate:safe:local": "node scripts/migrate.mjs --local",
    "migrate:safe:remote": "node scripts/migrate.mjs --remote",
    "fixtures": "node scripts/load-fixtures.mjs",
    "smoke": "bash scripts/smoke.sh",
    "check": "node --check src/index.js && node --check scripts/migrate.mjs && node --check scripts/load-fixtures.mjs"
  },
  "devDependencies": {
    "wrangler": "4.152.0"
  }
}
